			"command": "$path=(Resolve-Path .\\src\\app\\page.tsx).Path; $text=[IO.File]::ReadAllText($path); $old='p.description}</p><button className=\"add\" disabled={\"available\" in p&&!p.available} onClick={()=>add(p.id)}>{\"available\" in p&&!p.available?\"Agotado\":\"Agregar al carrito\"}</button>'; $new='p.description}</p>{!(\"available\" in p)||p.available?<><div className=\"qty\" aria-label={`Cantidad de ${p.name}`}><button type=\"button\" onClick={()=>adjustPickQty(p.id,-1)} aria-label={`Disminuir cantidad de ${p.name}`}><Minus size={14}/></button><span aria-live=\"polite\">{selectedQty(p.id)}</span><button type=\"button\" onClick={()=>adjustPickQty(p.id,1)} aria-label={`Aumentar cantidad de ${p.name}`}><Plus size={14}/></button></div><button className=\"add\" onClick={()=>add(p.id)}>Agregar al carrito · {formatPrice(p.price*selectedQty(p.id))}</button></>:<button className=\"add\" disabled>Agotado</button>}'; if(!$text.Contains($old)){throw \"No se encontró el fragmento del catálogo\"}; $text=$text.Replace($old,$new); $text=$text.Replace('onClick={()=>change(p.id,-p.qty)} aria-label=\"Eliminar\"','onClick={()=>remove(p.id)} aria-label={`Eliminar ${p.name}`}'); [IO.File]::WriteAllText($path,$text,(New-Object Text.UTF8Encoding($false)))",
