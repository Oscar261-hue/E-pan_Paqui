			"command": "$path=(Resolve-Path .\\src\\app\\page.tsx).Path; $text=[IO.File]::ReadAllText($path); $start=$text.IndexOf('p.description'); $end=$text.IndexOf('</button>',$start)+9; $found=($start -ge 0 -and $end -gt $start); if($found){$old=$text.Substring($start,$end-$start);$new='p.description}</p>{!(\"available\" in p)||p.available?<><div className=\"qty\" aria-label={`Cantidad de ${p.name}`}><button type=\"button\" onClick={()=>adjustPickQty(p.id,-1)} aria-label={`Disminuir cantidad de ${p.name}`}><Minus size={14}/></button><span aria-live=\"polite\">{selectedQty(p.id)}</span><button type=\"button\" onClick={()=>adjustPickQty(p.id,1)} aria-label={`Aumentar cantidad de ${p.name}`}><Plus size={14}/></button></div><button className=\"add\" onClick={()=>add(p.id)}>Agregar al carrito · {formatPrice(p.price*selectedQty(p.id))}</button></>:<button className=\"add\" disabled>Agotado</button>}';$text=$text.Substring(0,$start)+$new+$text.Substring($end);$text=$text.Replace('onClick={()=>change(p.id,-p.qty)} aria-label=\"Eliminar\"','onClick={()=>remove(p.id)} aria-label={`Eliminar ${p.name}`}');[IO.File]::WriteAllText($path,$text,(New-Object Text.UTF8Encoding($false)))}; Write-Output $found",
